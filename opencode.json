{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/mai-coding-default",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (OpenAI-compatible)",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "mai-coding-default": {
          "name": "MAI Coding (local)"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/rules/01-coding-standard.md",
    "~/.config/opencode/rules/02-security.md",
    "~/.config/opencode/rules/03-type-system.md",
    "~/.config/opencode/rules/04-clean-code.md",
    "~/.config/opencode/rules/05-complexity.md",
    "~/.config/opencode/rules/06-maintainability.md",
    "~/.config/opencode/rules/07-js-ts-tooling.md",
    "~/.config/opencode/rules/08-vue-svelte.md",
    "~/.config/opencode/rules/09-testing.md",
    "~/.config/opencode/rules/10-environment.md",
    "~/.config/opencode/rules/11-boundaries.md",
    "~/.config/opencode/rules/12-performance.md",
    "~/.config/opencode/rules/13-database.md",
    "~/.config/opencode/rules/14-dependencies.md",
    "~/.config/opencode/rules/15-observability.md",
    "~/.config/opencode/rules/16-accessibility.md",
    "~/.config/opencode/rules/17-i18n.md",
    "~/.config/opencode/rules/18-git-workflow.md",
    "~/.config/opencode/rules/19-css.md",
    "~/.config/opencode/rules/20-cpp.md"
  ],
  "skills": {
    "paths": ["~/.config/opencode/skills", "~/.config/opencode/skills/wondelai"]
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "task": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "deny",
    "bash": {
      "*":                              "ask",
      "pwd":                            "allow",
      "cd *":                           "allow",
      "ls*":                            "allow",
      "find *":                         "allow",
      "tree*":                          "allow",
      "rg *":                           "allow",
      "grep *":                         "allow",
      "sed *":                          "allow",
      "cat *":                          "allow",
      "head *":                         "allow",
      "tail *":                         "allow",
      "less *":                         "allow",
      "more *":                         "allow",
      "wc *":                           "allow",
      "sort *":                         "allow",
      "uniq *":                         "allow",
      "cut *":                          "allow",
      "awk *":                          "allow",
      "xargs *":                        "allow",
      "jq *":                           "allow",
      "stat *":                         "allow",
      "file *":                         "allow",
      "which *":                        "allow",
      "whereis *":                      "allow",
      "env":                            "allow",
      "printenv*":                      "allow",
      "date*":                          "allow",
      "uname*":                         "allow",
      "ps *":                           "allow",
      "lsof *":                         "allow",
      "ss *":                           "allow",
      "netstat *":                      "allow",
      "du *":                           "allow",
      "df *":                           "allow",
      "git status*":                    "allow",
      "git diff*":                      "allow",
      "git apply*":                     "allow",
      "git format-patch*":              "allow",
      "git log*":                       "allow",
      "git show*":                      "allow",
      "git branch*":                    "allow",
      "git worktree*":                  "allow",
      "git rev-parse*":                 "allow",
      "git remote -v":                  "allow",
      "git stash*":                     "allow",
      "git fetch*":                     "allow",
      "git pull*":                      "allow",
      "git merge*":                     "allow",
      "git rebase*":                    "deny",
      "git cherry-pick*":               "allow",
      "git checkout*":                  "allow",
      "git switch*":                    "allow",
      "git restore*":                   "allow",
      "git add*":                       "allow",
      "git push*":                      "deny",
      "git commit":                     "allow",
      "git commit *":                   "allow",
      "git tag*":                       "allow",
      "npm test*":                      "allow",
      "npm run test*":                  "allow",
      "pnpm test*":                     "allow",
      "pnpm run test*":                 "allow",
      "yarn test*":                     "allow",
      "composer test*":                 "allow",
      "phpunit*":                       "allow",
      "vendor/bin/phpunit*":            "allow",
      "vendor/bin/phpstan*":            "allow",
      "vendor/bin/php-cs-fixer*":       "allow",
      "eslint *":                       "allow",
      "prettier *":                     "allow",
      "tsc *":                          "allow",
      "vitest *":                       "allow",
      "jest *":                         "allow",
      "docker *":                       "ask",
      "docker-compose *":               "ask",
      "ddev *":                         "ask",
      "ssh *":                          "allow",
      "scp *":                          "deny",
      "rsync *":                        "ask",
      "rsync *:*":                      "deny",
      "curl *":                         "ask",
      "wget *":                         "ask",
      "apt search*":                    "allow",
      "apt-cache *":                    "allow",
      "apt list*":                      "allow",
      "apt*":                           "ask",
      "apt-get update*":                "ask",
      "apt-get*":                       "ask",
      "yum search*":                    "allow",
      "yum info*":                      "allow",
      "yum list*":                      "allow",
      "yum*":                           "ask",
      "dnf search*":                    "allow",
      "dnf info*":                      "allow",
      "dnf list*":                      "allow",
      "dnf repoquery*":                 "allow",
      "dnf*":                           "ask",
      "zypper search*":                 "allow",
      "zypper se*":                     "allow",
      "zypper info*":                   "allow",
      "zypper if*":                     "allow",
      "zypper repos*":                  "allow",
      "zypper lr*":                     "allow",
      "zypper*":                        "ask",
      "brew search*":                   "allow",
      "brew info*":                     "allow",
      "brew list*":                     "allow",
      "brew doctor*":                   "allow",
      "brew *":                         "ask",
      "npm install*":                   "ask",
      "pnpm add*":                      "ask",
      "pnpm install*":                  "ask",
      "yarn add*":                      "ask",
      "yarn install*":                  "ask",
      "composer require*":              "ask",
      "composer install*":              "ask",
      "pip install*":                   "deny",
      "pip3 install*":                  "deny",
      "flatpak install*":               "deny",
      "snap install*":                  "deny",
      "npm install -g*":                "deny",
      "npm publish*":                   "deny",
      "pnpm publish*":                  "deny",
      "yarn publish*":                  "deny",
      "cargo install*":                 "deny",
      "cargo publish*":                 "deny",
      "gem install*":                   "deny",
      "gem push*":                      "deny",
      "rm *":                           "ask",
      "mv *":                           "ask",
      "cp *":                           "ask",
      "chmod *":                        "ask",
      "chown *":                        "ask",
      "dd *":                           "deny",
      "mkfs*":                          "deny",
      "fdisk*":                         "deny",
      "parted*":                        "deny",
      "mount *":                        "ask",
      "umount *":                       "ask",
      "systemctl *":                    "ask",
      "service *":                      "ask",
      "launchctl *":                    "ask",
      "iptables*":                      "deny",
      "firewall-cmd *":                 "ask",
      "sysctl *":                       "ask",
      "passwd*":                        "deny",
      "useradd*":                       "deny",
      "userdel*":                       "deny",
      "groupadd*":                      "deny",
      "groupdel*":                      "deny",
      "visudo*":                        "deny",
      "crontab*":                       "ask",
      "sudo rpm*":                      "ask",
      "sudo systemctl*":                "ask",
      "sudo rm*":                       "ask",
      "sudo chmod*":                    "ask",
      "sudo chown*":                    "ask",
      "sudo dd*":                       "deny",
      "sudo mkfs*":                     "deny",
      "sudo fdisk*":                    "deny",
      "sudo parted*":                   "deny",
      "sudo passwd*":                   "deny",
      "sudo userdel*":                  "deny",
      "sudo groupdel*":                 "deny",
      "sudo visudo*":                   "deny",
      "sudo crontab*":                  "deny",
      "sudo mount*":                    "deny",
      "sudo umount*":                   "deny",
      "sudo iptables*":                 "deny",
      "sudo firewall-cmd --permanent*": "deny",
      "sudo sysctl -w*":                "deny",
      "rm -rf /*":                      "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "playwright-chromium": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium"]
    },
    "playwright-firefox": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "firefox"]
    },
    "mysql": {
      "type": "local",
      "command": ["npx", "-y", "@benborla29/mcp-server-mysql"],
      "environment": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "db",
        "MYSQL_PASS": "db",
        "MYSQL_DB": "",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "compaction": { "auto": true, "tail_turns": 15 }
}
